# Copy this file to .env and fill in the values for your environment.
# Required values must be set before the service starts.

APP_ENV=dev
APP_VERSION=0.1.0
API_PORT=8000
AI_SERVICE_KEY=

# Local Docker Postgres example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cms_ai
# Supabase examples:
# DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@db.<PROJECT>.supabase.co:5432/postgres
# DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?ssl=require
# Upstash Redis example:
# REDIS_URL=rediss://:<UPSTASH_PASSWORD>@<HOST>:6379
DATABASE_URL=

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
MODEL_SERVER_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
LLM_THINK=false
EMBED_MODEL=qwen3-embedding:0.6b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
JOB_CACHE_TTL_SECONDS=86400
HEALTH_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
