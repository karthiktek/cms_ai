# Copy this file to .env and fill in the values for your environment.
# Required values must be set before the service starts.

APP_ENV=dev
APP_VERSION=0.1.0
API_PORT=8000
AI_SERVICE_KEY=

# Local dev without Docker uses: Ollama app + Supabase Session pooler + Upstash Redis.
# Keep password characters URL-safe: @ => %40, # => %23, / => %2F, : => %3A
# Supabase session pooler example:
# DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
# Direct / transaction hosts are not supported for local dev.
# Upstash Redis example:
# REDIS_URL=rediss://:<UPSTASH_PASSWORD>@<HOST>:6379
# CELERY_BROKER_URL=rediss://:<UPSTASH_PASSWORD>@<HOST>:6379/0?ssl_cert_reqs=required
# CELERY_RESULT_BACKEND=rediss://:<UPSTASH_PASSWORD>@<HOST>:6379/0?ssl_cert_reqs=required
DATABASE_URL=

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
MODEL_SERVER_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
LLM_THINK=false
EMBED_MODEL=qwen3-embedding:0.6b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
JOB_CACHE_TTL_SECONDS=86400
# Remote dev databases (Supabase Sydney) need 15 seconds; default remains 2.
HEALTH_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
